Base body of the Clearpath Kingfisher M200 (hull, deck panels).
Ported from the original ROS 1 description to gz-sim. Link and joint names
are plain (base_link, ...) exactly as on the real robot;
a TF prefix is added by robot_state_publisher (frame_prefix), never baked into
the URDF. Hull dynamics are provided by the VRX Surface / SimpleHydrodynamics
plugins (see kingfisher_gazebo).

Frame convention (base_link, x forward, z up): the hull mesh spans
x -0.64..0.70, y +-0.49, z -0.22..0.10; keel at z = -0.22.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="kingfisher">
  <xacro:include filename="$(find kingfisher_description)/urdf/materials.urdf.xacro"/>

  <!-- === Physical parameters (tunable) === -->
  <!-- Total mass including payload/sensors, from the IsaacLab kingfisher env. -->
  <xacro:property name="kf_mass" value="35.0"/>
  <xacro:property name="kf_com_z" value="-0.05"/>
  <!-- Box approximation of a 35 kg, 1.34 x 0.97 x 0.32 m body. -->
  <xacro:property name="kf_ixx" value="3.0"/>
  <xacro:property name="kf_iyy" value="5.5"/>
  <xacro:property name="kf_izz" value="8.0"/>
  <!-- Hull geometry used for the collision boxes. -->
  <xacro:property name="kf_hull_length" value="1.3"/>
  <xacro:property name="kf_hull_width" value="0.2"/>
  <xacro:property name="kf_hull_height" value="0.22"/>
  <xacro:property name="kf_hull_y" value="0.38"/>

  <link name="base_link">
    <!-- Hull mesh. The STL is modelled y-up / x-right, hence the rotation. -->
    <visual name="hull_visual">
      <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://kingfisher_description/meshes/kingfisher_base.stl"/>
      </geometry>
      <material name="DarkGray"/>
    </visual>
    <visual name="left_panel_visual">
      <origin xyz="0 -0.35 0.05" rpy="${pi/2} 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://kingfisher_description/meshes/left_panel.stl"/>
      </geometry>
      <material name="Yellow"/>
    </visual>
    <visual name="right_panel_visual">
      <origin xyz="0 0.35 0.05" rpy="${pi/2} 0 ${-pi/2}"/>
      <geometry>
        <mesh filename="package://kingfisher_description/meshes/right_panel.stl"/>
      </geometry>
      <material name="Yellow"/>
    </visual>

    <!-- Primitive collisions: one box per hull plus the deck. -->
    <collision name="left_hull_collision">
      <origin xyz="0.03 ${kf_hull_y} ${-kf_hull_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${kf_hull_length} ${kf_hull_width} ${kf_hull_height}"/>
      </geometry>
    </collision>
    <collision name="right_hull_collision">
      <origin xyz="0.03 ${-kf_hull_y} ${-kf_hull_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${kf_hull_length} ${kf_hull_width} ${kf_hull_height}"/>
      </geometry>
    </collision>
    <collision name="deck_collision">
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.7 0.97 0.1"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="${kf_mass}"/>
      <origin xyz="0 0 ${kf_com_z}" rpy="0 0 0"/>
      <inertia ixx="${kf_ixx}" ixy="0" ixz="0" iyy="${kf_iyy}" iyz="0" izz="${kf_izz}"/>
    </inertial>
  </link>
</robot>
