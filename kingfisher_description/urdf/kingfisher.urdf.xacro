<?xml version="1.0"?>
<!--
Kingfisher M200, Gazebo-free top level (robot_state_publisher). Link names are
plain; the TF prefix comes from robot_state_publisher's frame_prefix.
kingfisher_gazebo/urdf/kingfisher_gazebo.urdf.xacro builds the sim on top.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="kingfisher">
  <xacro:include filename="$(find kingfisher_description)/urdf/kingfisher_base.urdf.xacro"/>
  <xacro:include filename="$(find kingfisher_description)/urdf/kingfisher_thruster.xacro"/>
  <xacro:include filename="$(find kingfisher_description)/urdf/kingfisher_sensors.xacro"/>
  <xacro:include filename="$(find kingfisher_description)/urdf/kingfisher_sail.xacro"/>

  <!-- Boat poses. They supersede kingfisher_bringup's static_tfs.launch.py,
       whose frames are renamed: sbg -> imu_link, laser -> lidar_link,
       gps_aN -> gps_aN_link, thruster_<side> -> <side>_thruster_link -->
  <xacro:kingfisher_thruster prefix="left" position="-0.53 0.3776 -0.16"/>
  <xacro:kingfisher_thruster prefix="right" position="-0.53 -0.3776 -0.16"/>
  <xacro:kingfisher_frame name="imu" xyz="-0.15 0 0.14"/>
  <!-- The SBG NavSatFix is really at the primary antenna -->
  <xacro:kingfisher_frame name="gps" parent="imu_link"/>
  <xacro:kingfisher_frame name="gps_a1" parent="imu_link" xyz="0.0 -0.37 0.0"/>
  <xacro:kingfisher_frame name="gps_a2" parent="imu_link" xyz="0.0 0.37 0.0"/>
  <xacro:kingfisher_frame name="lidar" xyz="0.265 0 0.10" rpy="0 0 0"/>
  <xacro:kingfisher_camera name="camera" xyz="0.33 0 0.04"/>
  <xacro:kingfisher_frame name="anemometer" xyz="-0.60 -0.19 0.25" rpy="${pi} 0 0"/>

  <!-- Replaces static_tfs' sail_encoder_link -->
  <xacro:kingfisher_sail xyz="-0.04 0 0.25"/>
</robot>
